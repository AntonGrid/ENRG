# ENRG — example environment (audit 2026-09-21)
#
# Copy to `.env` (docker compose reads that file automatically) or export the
# variables you need. Every value below is a placeholder, not a secret.
#
# Key handling (ADR-0007 / audit H-1):
#   * prefer the *_PATH variables — the secret then never enters the environment
#     (which is readable from /proc/<pid>/environ and visible in `docker inspect`)
#   * never commit a key file: .gitignore already blocks `*-keypair.json`,
#     `deploy/`, `keypairs/`, `founder-wallet.json`, `enrg-wallet.json`
#   * keep key files mode 0600 and outside the repository

# ── RPC / cluster ────────────────────────────────────────────────────────────
# Single endpoint. Default inside server.js is devnet if unset.
RPC_ENDPOINT=https://api.devnet.solana.com
# Failover list (P0-3): comma-separated, tried in order when one endpoint fails.
# Point each oracle instance at different providers (MULTI-ORACLE-ROLLOUT.md).
RPC_ENDPOINTS=https://api.devnet.solana.com

# ── Keys and authorities ─────────────────────────────────────────────────────
# Protocol admin (vault.authority): device revoke/rotate, buyback path.
FOUNDER_KEY_PATH=/secure/founder-wallet.json
# FOUNDER_KEY=[1,2,3,...]          # H-1: discouraged, only for throwaway setups
# This oracle instance's key — it signs quorum votes and the mint transaction.
ORACLE_KEY_PATH=/secure/oracle-keypair.json
# ORACLE_KEY=[...]
# Firmware signing key (ADR-0008) — signs OTA metadata served to devices.
FIRMWARE_SIGNING_KEY_PATH=/secure/firmware-signing-keypair.json
# Admin secret for POST /api/v1/firmware/update (P1-7). Empty ⇒ that endpoint
# answers 503 firmware_admin_key_missing instead of accepting anonymous uploads.
FIRMWARE_ADMIN_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Postgres when set, otherwise SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/enrg
# SQLite path (default ./enrg.db). Inside docker-compose this is /app/data/enrg.db.
ENRG_SQLITE_PATH=./data/enrg.db

# ── Program interface ────────────────────────────────────────────────────────
# Anchor IDL. Default is target/idl/enrg_mvp.json; the tracked copy lives in
# idls/enrg_mvp.json and is what the Docker image uses.
ENRG_IDL_PATH=idls/enrg_mvp.json
# Policy engine configuration (ADR-0003). Default is policy-config.json.
POLICY_CONFIG_PATH=policy-config.json

# ── Oracle behaviour ─────────────────────────────────────────────────────────
PORT=3000
# Per-device rate limit in ms between accepted proofs (0 = disabled).
DEVICE_MIN_INTERVAL_MS=0
# Opt in to the on-chain oracle quorum for minting (1 = on). Requires at least
# two staked oracles in the registry; see docs/MULTI-ORACLE-ROLLOUT.md.
ENRG_QUORUM_ATTEST=1
# Mint queue (P0-2): size, attempts per proof and exponential backoff base.
MINT_QUEUE_MAX=10000
MINT_MAX_ATTEMPTS=8
MINT_RETRY_BASE_MS=5000
# Only mint proofs at or above this energy in Wh (P3-2).
MINT_MIN_ENERGY_WH=0
# OTA image directory (ADR-0008) — must be writable and mounted in Docker.
FIRMWARE_UPDATES_DIR=firmware/updates

# ── Manifest registry service (oracle/registry) ──────────────────────────────
# Required by that service (≥32 chars) — it refuses to start without it (H-5).
REGISTRY_ADMIN_KEY=change-me-to-a-long-random-string
SERVICE_NAME=enrg-manifest-registry
