    "/api/v1/proof/submit": {
      "post": {
        "tags": [
          "proof"
        ],
        "summary": "Submit an energy proof (the main ingestion endpoint)",
        "operationId": "post_api_v1_proof_submit",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Accepted — `mint` is one of `queued` | `deferred` (with `mint_reason`) | `already_minted`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid proof, bad signature, clock skew or policy rejection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Device revoked on-chain",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "RPC unavailable (retry)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "description": "Verification is against the on-chain EnergyProducer account, not the local DB. The decisive check is the device Ed25519 signature over SHA-256(device_id‖nonce‖device_timestamp‖energy_wh); the same hash is what oracles vote on. Minting is queued and resumes across restarts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "description": "base58 device public key"
                  },
                  "nonce": {
                    "description": "monotonic uint64 counter from the device"
                  },
                  "device_timestamp": {
                    "description": "unix seconds reported by the device (clock-skew checked)"
                  },
                  "energy_wh": {
                    "description": "energy in watt-hours since the previous report"
                  },
                  "device_signature": {
                    "description": "Ed25519 signature, array of 64 bytes"
                  },
                  "signature": {
                    "description": "legacy string signature (accepted for accumulation only, cannot mint)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "tags": [
          "public metrics"
        ],
        "summary": "Protocol metrics from the proofs table (single source of truth)",
        "operationId": "get_api_v1_stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "total_proofs, minted_proofs, deferred_proofs, accepted_proofs, energy, active_producers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "description": "Counts one row per proof (device_id + nonce), so a proof attested by several oracles is not double counted; `attestation_rows` exposes the raw row count separately."
      }
    },
    "/api/v1/oracles": {
      "get": {
        "tags": [
          "public metrics"
        ],
        "summary": "Oracle network: the on-chain trusted set + per-oracle attribution",
        "operationId": "get_api_v1_oracles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "oracles[], counts{registered,with_proofs,idle}, unattributed_proofs, note",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "description": "`counts` separates registered keys from keys that have actually handled proofs. `unattributed_proofs` counts rows recorded before per-oracle attribution existed (2026-08-30) — they cannot be assigned to an oracle and are reported instead of being silently shown as 0 for every oracle."
      }
    }
