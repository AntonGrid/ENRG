{
  "schema_version": "1.0",
  "normative_source": "Axis-protocol (L0): spec/protocol/validation.md §2.3-2.4, ADR-0003, ADR-0005",
  "scope": "The DECISION of the on-chain Policy Engine (ENRG, Rust) vs its declared mirror in the reference implementation (Axis-core, Python). Only (allowed, reason) is compared — never internals.",
  "how_to_run": "ENRG: cargo test -p enrg-mvp policy_conformance | Axis-core: AXIS_CONFORMANCE_VECTORS=<path> pytest -q tests/test_policy_conformance.py",
  "defaults": {
    "now": 1700000000,
    "note": "month_start_ts is always inside the 30-day window (now - 60 s), so month_energy_wh is effective."
  },
  "reason_codes": {
    "mint_paused": "global mint switch off (policy.mint_enabled = false)",
    "untrusted_oracle": "policy.enforce_oracle_whitelist = true and oracle_trusted = false",
    "invalid_device_state": "device not Active (ADR-0005) or revoked",
    "stale_timestamp": "now - verified_at > 900 s (MAX_PROOF_AGE)",
    "future_timestamp": "verified_at > now + max_clock_skew_sec",
    "tier_limit_exceeded": "month_energy + report.energy_wh > tier monthly limit (v7.0 §15)",
    "excessive_energy": "report.energy_wh > rated_power_wh * max_energy_bps / 10_000",
    "zero_amount_mint": "computed reward = 0",
    "supply_limit_exceeded": "total_supply + reward > max_supply"
  },
